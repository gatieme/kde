flowchart LR
    subgraph RSS_Agent["RSS Agent Workflow (LangGraph StateGraph)"]
        direction TB

        DETECT["detect_protection<br/>- Cloudflare detection<br/>- Turnstile detection<br/>- CAPTCHA handling"]
        FETCH_RSS["fetch_rss_feeds<br/>- feedparser<br/>- Multi-source support"]
        FETCH_ART["fetch_article_content<br/>- requests<br/>- httpx<br/>- Playwright"]
        ANALYZE["analyze_articles<br/>- Kernel keywords<br/>- Patch links"]
        GEN_SUM["generate_summaries<br/>- AI summary<br/>- Classification"]
        OUTPUT["output_results<br/>- Markdown format"]
    end

    subgraph AntiCrawler["Anti-Crawler Bypass"]
        FINGERPRINT["Real browser fingerprint"]
        MOUSE["Mouse movement & scroll simulation"]
        COOKIE["Cookie & localStorage"]
        NAVIGATE["Multi-step navigation<br/>(Google → Target)"]
    end

    subgraph Cache["Disk Cache System"]
        CACHE_DIR["output/rss/"]
        CACHE_FILE["{hash-id}.txt<br/>(MD5 hash of URL)"]
    end

    DETECT --> FETCH_RSS --> FETCH_ART --> ANALYZE --> GEN_SUM --> OUTPUT

    FETCH_ART --> AntiCrawler
    AntiCrawler --> FINGERPRINT
    AntiCrawler --> MOUSE
    AntiCrawler --> COOKIE
    AntiCrawler --> NAVIGATE

    FETCH_ART --> CACHE_DIR
    CACHE_DIR --> CACHE_FILE

    style RSS_Agent fill:#fff3e0
    style AntiCrawler fill:#ffebee
    style Cache fill:#e8f5e9
